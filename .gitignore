# ============================================================
# .gitignore — BC5CDR Clinical NER System
# ============================================================
# Rule of thumb: anything Render/Streamlit need at startup to
# LOAD THE MODEL or SERVE THE APP must be pushed (ner_models/,
# data/sample dataset). Anything auto-generated by running tests
# or training locally must NOT be pushed (caches, coverage, mlruns).
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.env
venv/
.venv/
env/

# ── Testing / Coverage (auto-generated — do NOT push) ────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── MLflow (auto-generated locally — do NOT push) ─────────────
mlruns/
mlartifacts/

# ── Logs (auto-generated at runtime — do NOT push) ────────────
logs/*.csv
logs/*.log
!logs/.gitkeep

# ── Jupyter ─────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Data — push ONLY the small sample dataset ─────────────────
# Everything else in data/ (large raw downloads, if any) is ignored.
# IMPORTANT: rename the pattern below to match your actual sample
# dataset filename if it's different.
data/*
!data/.gitkeep
!data/sample_clinical_texts.csv

# ── Model artifacts — PUSH these (Render/Streamlit need them) ─
# ner_models/ is intentionally NOT ignored — the champion model,
# registry, and model card must be in the repo for the API to
# load at startup on Render and for the dashboard to read metrics.
# If ner_models/ner_model_BioBERT_v1/ contains a file over ~90MB
# (check with the size command in the deployment guide below),
# you MUST use Git LFS for it — plain git will reject the push.

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Training checkpoints (never needed) ────────────
ner_models/bert_run/

# ── Final BioBERT model — hosted on HF Hub, not in git ──
ner_models/ner_model_BioBERT_v1/